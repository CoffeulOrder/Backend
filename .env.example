# 실제 값은 각자 로컬 .env에만 채우고 절대 커밋하지 않는다 (.gitignore 처리됨).
# 키 목록 출처: docs/scope-src/rules.py CONFIG_KEYS (개발 규칙 탭 원본, 이름은 팀 공통 약속에서 최종 확정)

SPRING_PROFILES_ACTIVE=dev

# RDS 접속 (serverTimezone=UTC) — 운영은 Secrets Manager
DB_URL=jdbc:mysql://localhost:3306/coffeul?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# access 토큰 서명 키 (256비트 이상) — 운영은 Secrets Manager
JWT_SECRET=

AWS_REGION=ap-northeast-2

# merchant_pg.secret_ref를 찾을 Secrets Manager 경로 접두어
PG_SECRET_PREFIX=

# fake | toss (PG사 확정 전에는 fake)
PAYMENT_GATEWAY=fake

# 메뉴 이미지 버킷 · CloudFront 주소
S3_MENU_BUCKET=
CDN_BASE_URL=

# Expo 강화 보안 토큰 — 운영은 Secrets Manager
EXPO_ACCESS_TOKEN=

# 인증 메일 발신 주소 · ses | smtp (SMTP 비밀번호는 Secrets Manager)
MAIL_FROM=
MAIL_PROVIDER=ses

# 팀 알림 대상 (CloudWatch → 메일 · 슬랙)
OPS_ALERT_TOPIC=
